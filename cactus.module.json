{
  "name": "square-payment-for-shop",
  "version": "0.1.7",
  "tablePrefix": "sqp_",
  "description": "Square Payments for the Shop: card payments taken on Square's hosted checkout page, with refunds and webhook confirmation. No card data ever touches the site.",
  "requiresCoreVersion": "0.5.875",
  "requiresModules": [
    { "name": "shop", "minVersion": "0.1.175" }
  ],
  "requiredEnvVars": [
    { "name": "SQUARE_ACCESS_TOKEN", "required": false },
    { "name": "SQUARE_LOCATION_ID", "required": false },
    { "name": "SQUARE_WEBHOOK_SIGNATURE_KEY", "required": false },
    { "name": "SQUARE_SANDBOX_ACCESS_TOKEN", "required": false },
    { "name": "SQUARE_SANDBOX_LOCATION_ID", "required": false },
    { "name": "SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY", "required": false },
    { "name": "SQUARE_ENVIRONMENT", "required": false }
  ],
  "permissions": [],
  "settingsTabs": [
    { "id": "square-payments", "label": "Square", "permission": "shop.manage", "host": "shop.payments", "import": "./components/admin/SettingsTab", "component": "SquareSettingsTab" }
  ],
  "extensionPoints": [
    { "point": "shop.payment-providers", "id": "square-payments", "import": "./lib/provider", "component": "squarePaymentProvider" }
  ],
  "teardown": [
    "sqp_payments",
    "sqp_settings"
  ],
  "cookieCategories": [],
  "cronJobs": [],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": []
  }
}
